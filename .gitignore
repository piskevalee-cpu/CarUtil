# Python bytecode
__pycache__/
*.py[cod]
.venv/

# Converted archives (some are 100-200 MB and contain third-party assets)
*.scs
*.zip

# Reference output extracted from the third-party converter. That material is
# DN Modding's, not ours to redistribute; regenerate it locally if needed.
reference/tool_output/

# Logo sources are tracked (scripts/logos/), but anything dropped in for a one-off
# conversion is not.
scripts/logos/*.tmp
scripts/logos/*.dds

# Scratch
*.log
*.tmp

# Updater state and rollback data
/.carutil-update/
